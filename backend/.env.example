# Todas las variables son opcionales.

# Carpeta de música (relativa a backend/ o absoluta)
MUSIC_PATH=./music

# Carpeta de datos y base SQLite (por defecto %APPDATA%\DR Music Free)
# DATA_DIR=
# DB_PATH=

# Carpeta bin de ffmpeg (si no se define se usa el PATH)
# FFMPEG_PATH=

# Orígenes permitidos para el frontend en desarrollo (separados por comas)
# CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Solo para migrate_from_postgres.py (antigua base PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tudatabase
DB_USER=postgres
DB_PASSWORD=tu_contraseña
